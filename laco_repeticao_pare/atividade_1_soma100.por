programa 
{
	//Faça um programa que calcule a soma dos
	//números de 1 a 100
	
	funcao inicio() 
	{
		inteiro resultado, contador
		

		para (contador = 0; contador<100; contador++) 
		{
			resultado = 1 + contador 
			escreva (1,"+", contador, " = ", resultado , "\n")
		}
	}
}
