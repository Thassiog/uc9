programa
{
	
funcao acoesprincipais()
	{
		escreva("está é uma mensagem da rotina principal.\n")
		mostrarmensagem()
	}
	funcao mostrarmensagem()
	{
		escreva("está é uma mensagem de sub-rotina.")
	}
	funcao inicio()
	{
	acoesprincipais()
	}
}
