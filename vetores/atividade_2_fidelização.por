programa
{
	
	funcao inicio() 
	{
		inteiro vetor[9]
		real valor
			escreva("digite o valor ")
		 		leia(valor)
		para (inteiro posicao = 0; posicao < 9; posicao++)
		{
			escreva("digite o valor ")
			leia(valor)
		}

		escreva ("\n", "hoje seu almoço é por conta da casa!!!")

	}
}
